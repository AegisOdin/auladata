# Copy to .env; generate your own secrets. Never commit the completed file.
# Values also work as a trusted Bash env file. Quote passwords/special characters.
APP_ENV=DEV
APP_VERSION=development
GIT_COMMIT=unknown
POSTGRES_DB=auladata_dev
POSTGRES_USER=auladata
POSTGRES_PASSWORD=
# URL-encode special characters in the password component of DATABASE_URL.
DATABASE_URL="postgresql+psycopg://auladata:${POSTGRES_PASSWORD}@postgres:5432/auladata_dev"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ADMIN_INITIAL_NAME="Administración AulaData"
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
VIEWER_INITIAL_NAME="Consulta AulaData"
VIEWER_INITIAL_EMAIL=viewer@example.com
VIEWER_INITIAL_PASSWORD=
SEED_DEMO=false
LOG_LEVEL=INFO
API_INTERNAL_URL=http://backend:8000
APP_BIND_ADDRESS=127.0.0.1
