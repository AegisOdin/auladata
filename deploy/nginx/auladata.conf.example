# Install on the external DMZ proxy, not inside the app Compose stack.
# Replace APP_VM_ADDRESS and TLS paths after provisioning each environment.
# The same example supports DEV, QA and PROD with independent upstream VMs.
upstream auladata_api {
    server APP_VM_ADDRESS:8000;
    keepalive 8;
}
upstream auladata_web {
    server APP_VM_ADDRESS:3000;
    keepalive 8;
}
server {
    listen 80;
    server_name YOUR_AULADATA_HOSTNAME;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name YOUR_AULADATA_HOSTNAME;
    ssl_certificate /etc/nginx/tls/auladata.crt;
    ssl_certificate_key /etc/nginx/tls/auladata.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    location /api/ { proxy_pass http://auladata_api; }
    location = /health { proxy_pass http://auladata_api; add_header Cache-Control "no-store" always; }
    location = /ready { proxy_pass http://auladata_api; add_header Cache-Control "no-store" always; }
    location / { proxy_pass http://auladata_web; }
}
