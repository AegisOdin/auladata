# PROD needs HTTPS at the external proxy and its own PostgreSQL VM/database.
APP_ENV=PROD
APP_BIND_ADDRESS=
BASE_URL=
DATABASE_URL=
JWT_SECRET=
COOKIE_SECURE=true
CORS_ORIGINS=
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
VIEWER_INITIAL_EMAIL=viewer@example.com
VIEWER_INITIAL_PASSWORD=
SMOKE_EMAIL=viewer@example.com
SMOKE_PASSWORD=
STATE_DIR=/var/lib/auladata/prod
BACKUP_DIR=/var/backups/auladata/prod
BACKUP_IMAGE=postgres:17-alpine
LOG_LEVEL=INFO
