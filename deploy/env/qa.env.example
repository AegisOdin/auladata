# QA addresses must be supplied after provisioning; no address is assumed real.
APP_ENV=QA
APP_BIND_ADDRESS=
BASE_URL=
DATABASE_URL=
JWT_SECRET=
COOKIE_SECURE=true
CORS_ORIGINS=
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
VIEWER_INITIAL_EMAIL=viewer@example.com
VIEWER_INITIAL_PASSWORD=
SMOKE_EMAIL=viewer@example.com
SMOKE_PASSWORD=
STATE_DIR=/var/lib/auladata/qa
BACKUP_DIR=/var/backups/auladata/qa
LOG_LEVEL=INFO
