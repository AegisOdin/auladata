# Install outside Git, e.g. /etc/auladata/dev.env, owned by deploy user, chmod 600.
# Trusted Bash syntax; quote values. All passwords are intentionally blank.
APP_ENV=DEV
APP_BIND_ADDRESS=10.10.30.10
BASE_URL=http://10.10.30.10:3000
DATABASE_URL=
JWT_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=http://10.10.30.10:3000
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
VIEWER_INITIAL_EMAIL=viewer@example.com
VIEWER_INITIAL_PASSWORD=
SMOKE_EMAIL=viewer@example.com
SMOKE_PASSWORD=
STATE_DIR=/var/lib/auladata/dev
BACKUP_DIR=/var/backups/auladata/dev
LOG_LEVEL=INFO
